# ==============================================================================
# AMAZON AFFILIATE E-COMMERCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure with your own values.
# NEVER commit real passwords, MongoDB URIs, or JWT secrets to source control.
# This project's database MUST be separate from SalonSync and Secure E-Voting.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (MUST point to the ecs_affiliate database ONLY)
# Local: mongodb://localhost:27017/ecs_affiliate
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecs_affiliate?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ecs_affiliate

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
ADMIN_DEFAULT_EMAIL=admin@affilify.com
ADMIN_DEFAULT_PASSWORD=change_this_in_production

# Amazon Affiliate Credentials (only used by this project)
# AMAZON_CREDENTIAL_ID=
# AMAZON_CREDENTIAL_SECRET=
# AMAZON_PARTNER_TAG=
# AMAZON_MARKETPLACE=www.amazon.in
